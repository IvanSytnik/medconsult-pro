# Backend API base URL
VITE_API_URL=http://localhost:3000/api

# Production example:
# VITE_API_URL=https://api.example.com/api

# Contact details. They are not stored in the repository; set the real values in the
# hosting provider's environment. Without them the site shows the placeholders below.
# Main phone: footer, contact section, Impressum, privacy policy, direct-contact buttons.
VITE_CONTACT_PHONE=+49 000 0000000
# WhatsApp number of the floating button and of the contact form's fallback link.
VITE_WHATSAPP_PHONE=+49 000 0000000

# Team cards on the home page: chief coordinator, finance advisor, travel coordinator.
# NAME is used in every language unless NAME_DE / NAME_RU / NAME_UK / NAME_EN is set.
# Without a name the card shows the role; without a photo URL it shows an icon.
# The chief coordinator's name is also shown in the Impressum under "Vertreten durch".
VITE_TEAM_CHIEF_NAME=
VITE_TEAM_CHIEF_NAME_RU=
VITE_TEAM_CHIEF_NAME_UK=
VITE_TEAM_CHIEF_PHONE=+49 000 0000000
VITE_TEAM_CHIEF_PHOTO=
VITE_TEAM_FINANCE_NAME=
VITE_TEAM_FINANCE_NAME_RU=
VITE_TEAM_FINANCE_NAME_UK=
VITE_TEAM_FINANCE_PHONE=+49 000 0000000
VITE_TEAM_FINANCE_PHOTO=
VITE_TEAM_TRAVEL_NAME=
VITE_TEAM_TRAVEL_NAME_RU=
VITE_TEAM_TRAVEL_NAME_UK=
VITE_TEAM_TRAVEL_PHONE=+49 000 0000000
VITE_TEAM_TRAVEL_PHOTO=
