# Server
PORT=3000
# Origin of the deployed frontend (required in production for CORS)
FRONTEND_URL=http://localhost:5173

# Telegram bot (optional)
# Create a bot with @BotFather, add it to a group and use the group chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail (optional, Gmail example)
# Requires 2-Step Verification and an App Password:
# Google Account > Security > App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=info@medconsult-turkey.com
