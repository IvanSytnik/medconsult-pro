# Public site URL, used for canonical links, hreflang and the sitemap.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL on Vercel, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://medconsult.sytnik-studio.com

# Telegram bot (optional)
# Create a bot with @BotFather, add it to a group and use the group chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail via Resend (optional; without RESEND_API_KEY only Telegram is used)
# The sender domain must be verified in Resend (sytnik-studio.com).
RESEND_API_KEY=
EMAIL_FROM=MedConsult Turkey <noreply@sytnik-studio.com>
# Comma-separated list of recipients
EMAIL_TO=info@medconsult-turkey.com

# Search indexing stays off until cutover. Set to true only on the final domain.
NEXT_PUBLIC_ALLOW_INDEXING=false
